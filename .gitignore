# POWDER 118 Exclusions

# 1. Executables (support tools & game binaries)
*.exe

# 2. Generated Graphics Pipeline (rebuilt by gfx/rebuild.sh)
gfx/all_bitmaps.cpp
gfx/all_bitmaps.h

# 3. Visual Studio Caches & Per-User Files (any depth)
.vs/
*.user
*.suo

# 4. Visual Studio Migration & Upgrade Artifacts (strictly scoped to port/windows)
port/windows/Backup/
port/windows/UpgradeLog*
port/windows/_UpgradeReport_Files/

# 5. Build Artifacts
port/windows/Release/
port/windows/Debug/
gfx/akoi3x/sprite16_3x.bmp
gfx/*.c
gfx/*/*.c
rooms/*.cpp
rooms/*.h
support/*/*.o
.asset_checksum
credits.cpp
encyclopedia.cpp
encyclopedia.h
glbdef.cpp
glbdef.h
license.cpp

# User items
.vscode/*.code-workspace
.vscode/settings.json
powder.sav